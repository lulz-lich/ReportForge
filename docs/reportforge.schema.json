{
  "$defs": {
    "Classification": {
      "description": "Report handling classification.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Effort": {
      "description": "High-level remediation effort.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Effort",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Evidence item for a finding.",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe artifact reference, redacted snippet, screenshot path, or ticket link.",
          "title": "Artifact"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "Technical finding schema.",
      "properties": {
        "id": {
          "examples": [
            "RF-001"
          ],
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "likelihood": {
          "$ref": "#/$defs/Severity",
          "default": "medium"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus",
          "default": "open"
        },
        "remediation_effort": {
          "$ref": "#/$defs/Effort",
          "default": "medium"
        },
        "affected_asset": {
          "minLength": 1,
          "title": "Affected Asset",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "recommendation": {
          "minLength": 1,
          "title": "Recommendation",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "severity",
        "affected_asset",
        "description",
        "impact",
        "recommendation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingStatus": {
      "description": "Lifecycle status for a finding.",
      "enum": [
        "open",
        "in_progress",
        "remediated",
        "risk_accepted"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Language": {
      "description": "Supported report languages.",
      "enum": [
        "en",
        "pt"
      ],
      "title": "Language",
      "type": "string"
    },
    "Severity": {
      "description": "Supported severity ratings.",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TimelineEvent": {
      "additionalProperties": false,
      "description": "Timeline event included in the report.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "date",
        "title",
        "description"
      ],
      "title": "TimelineEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete report project schema.",
  "properties": {
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "report_version": {
      "default": "1.0",
      "minLength": 1,
      "title": "Report Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "client": {
      "minLength": 1,
      "title": "Client",
      "type": "string"
    },
    "language": {
      "$ref": "#/$defs/Language",
      "default": "en"
    },
    "classification": {
      "$ref": "#/$defs/Classification",
      "default": "confidential"
    },
    "assessment_type": {
      "default": "Authorized Penetration Test",
      "minLength": 1,
      "title": "Assessment Type",
      "type": "string"
    },
    "assessment_start": {
      "format": "date",
      "title": "Assessment Start",
      "type": "string"
    },
    "assessment_end": {
      "format": "date",
      "title": "Assessment End",
      "type": "string"
    },
    "prepared_by": {
      "minLength": 1,
      "title": "Prepared By",
      "type": "string"
    },
    "executive_summary": {
      "minLength": 1,
      "title": "Executive Summary",
      "type": "string"
    },
    "methodology": {
      "default": "The assessment used authorized, non-destructive validation and evidence-safe documentation practices.",
      "minLength": 1,
      "title": "Methodology",
      "type": "string"
    },
    "limitations": {
      "default": "Testing was limited to the approved scope and rules of engagement.",
      "minLength": 1,
      "title": "Limitations",
      "type": "string"
    },
    "conclusion": {
      "default": "Remediation should prioritize high-severity findings, exposed business risk, and controls that improve detection and response.",
      "minLength": 1,
      "title": "Conclusion",
      "type": "string"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    },
    "rules_of_engagement": {
      "items": {
        "type": "string"
      },
      "title": "Rules Of Engagement",
      "type": "array"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      },
      "title": "Timeline",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "title",
    "client",
    "assessment_start",
    "assessment_end",
    "prepared_by",
    "executive_summary"
  ],
  "title": "Report",
  "type": "object"
}